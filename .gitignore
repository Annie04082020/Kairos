# ==============================================================================
# Kairos - Local & Private Focus Engine (.gitignore)
# ==============================================================================

# 1. Private User Data & Databases (100% Zero-Telemetry Guarantee)
# Never commit personal usage tracking databases or activity history!
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.db
*.sqlite
*.sqlite3
!data/.gitkeep

# Data exports and backups
*export*.json
*backup*.json
data/*.json

# 2. Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. IDEs, Editors & Tooling
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/
*.swp
*.swo
*~

# 4. Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 5. Logs & Temporary Files
*.log
logs/
temp/
tmp/
scratch/
test_*.py
.pytest_cache/
.coverage
htmlcov/

# 6. Web & Node (if package managers used in the future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. Local Secrets & Environments
.env
.env.local
.env.*.local
*.local
